{
    "name": "@mfe-orchestrator/template-web-component-remote",
    "version": "0.0.0",
    "private": false,
    "type": "module",
    "main": "./dist/index.umd.js",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js"
        }
    },
    "files": [
        "dist/"
    ],
    "repository": {
        "type": "git",
        "url": "https://azimutsrl@dev.azure.com/azimutsrl/Azimut%20Spagna/_git/azimut-espana-signature-fe"
    },
    "packageManager": "pnpm@11.21.0",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc && vite build",
        "build:watch": "tsc && vite build --w",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "prettier-format": "prettier --config .prettierrc './**/*.ts*' --write"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.5.4",
        "lint-staged": "^17.3.0",
        "postcss": "^8.5.26",
        "postcss-import": "17.0.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sass": "^1.102.0",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "vite": "^8.2.1",
        "vite-tsconfig-paths": "^6.1.1"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "npx prettier --write",
            "npx eslint --fix"
        ]
    },
    "msw": {
        "workerDirectory": [
            "src/mocks"
        ]
    },
    "dependencies": {
        "@r2wc/react-to-web-component": "^2.1.1",
        "@rollup/plugin-typescript": "^12.3.0",
        "vite-plugin-lib-inject-css": "^2.2.2"
    }
}
