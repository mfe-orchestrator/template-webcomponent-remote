{
    "name": "@mfe-orchestrator/template-web-component-remote",
    "version": "0.0.0",
    "private": false,
    "type": "module",
    "main": "./dist/index.umd.js",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js"
        }
    },
    "files": [
        "dist/"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/mfe-orchestrator/template-webcomponent-remote.git"
    },
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc && vite build",
        "build:watch": "tsc && vite build --w",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "prettier-format": "prettier --config .prettierrc './**/*.ts*' --write"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.13.0",
        "lint-staged": "^17.6.0",
        "postcss": "^8.5.30",
        "postcss-import": "17.0.1",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sass": "^1.105.2",
        "tslib": "^2.8.1",
        "typescript": "~6.0.3",
        "vite": "^8.3.4"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "npx prettier --write",
            "npx eslint --fix"
        ]
    },
    "msw": {
        "workerDirectory": [
            "src/mocks"
        ]
    },
    "dependencies": {
        "@r2wc/react-to-web-component": "^2.1.1",
        "@rollup/plugin-typescript": "^12.3.0",
        "vite-plugin-lib-inject-css": "^2.2.2"
    }
}
